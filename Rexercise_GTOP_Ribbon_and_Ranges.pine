string G_ALERTS = "09 | 9ate8 observations and alerts"
bool observeEight = input.bool(true, "Observe 8 AM / 8 PM range during its next shift", group=G_ALERTS, tooltip="Observes 9 AM-noon and 9 PM-midnight only. A sweep means price exceeded a range extreme. Invalidation requires a completed hourly candle closing strictly outside the 8 o'clock range. Monitoring that range then stops for the shift. No automatic roll to 9/10/11, variant claim, CSD, or entry signal.")
bool showFocus = input.bool(false, "Compact latest-bar 9ate8 status card", group=G_ALERTS, tooltip="The card reports the latest chart bar, including Bar Replay. It does not follow the crosshair or your scrolled historical viewport.")
// Create an alert from this indicator's named conditions in TradingView.
// Use Once Per Bar for sweeps, and Once Per Bar Close for hourly invalidation.
// A 1m/5m chart gives prompt observations. Higher charts deliver alerts at their
// update/close cadence; the hourly-close rule itself still uses hour boundaries.
// On a developing higher-timeframe chart, the final returned intrabar is
// conservatively confirmed only once a later intrabar arrives (up to one sample
// of latency). Wall-clock time alone never confirms a delayed-feed candle.

// Context is explicitly selected, never inferred as a directional trade thesis.
string G_CONTEXT = "10 | Gray higher-timeframe context"
string contextSource = input.string("Previous week", "Gray context range", options=["Off", "Previous day", "Previous week", "Previous month", "Manual bounds"], group=G_CONTEXT)
